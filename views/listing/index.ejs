<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zariya</title>
</head>
<body>
    <ul>
        <h3>All Listings</h3>
        <form action="/listings/new" method="get">
            <button>Add a new Property</button>
        </form>
        <% for(listings of allListings){ %>
            <li><a href="/listings/<%= listings._id %>"><%= listings.title %></a></li>
        <% } %>
    </ul>
</body>
</html>

